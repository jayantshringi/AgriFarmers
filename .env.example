# ==============================================================================
# AgriFarmers Environment Configuration Template (.env)
# ==============================================================================

# Server Port & Runtime
PORT=3000
NODE_ENV=development

# Supabase Database Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key

# TextBee SMS Gateway Configuration
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_SIM_SUBSCRIPTION_ID=

# Cryptographic & Session Configuration
# Generate a strong 32+ character random string for production
OTP_SECRET=
OTP_TTL_SECONDS=120
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5

# CORS Allowed Origins (Comma-separated list)
# Default whitelist includes: https://agrifarmers.vercel.app, http://localhost:3000, http://127.0.0.1:3000
CORS_ORIGIN=https://agrifarmers.vercel.app,http://localhost:3000,http://127.0.0.1:3000
